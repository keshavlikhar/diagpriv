{
  "category": "payment_processing",
  "description": "A fictional customer was charged twice for one logical payment.",
  "diagnostic_invariants": [
    {
      "description": "Duplicate rows must retain the same customer relationship.",
      "fields": [
        "payments.customer_id"
      ],
      "must_preserve": true,
      "name": "customer_equality",
      "type": "equality"
    },
    {
      "description": "Duplicate rows must retain the same account relationship.",
      "fields": [
        "payments.account_id"
      ],
      "must_preserve": true,
      "name": "account_equality",
      "type": "equality"
    },
    {
      "description": "The two successful records must remain recognizable as one logical payment.",
      "fields": [
        "payments.customer_id",
        "payments.account_id",
        "payments.request_id",
        "payments.amount"
      ],
      "must_preserve": true,
      "name": "payment_duplicate",
      "type": "duplicates"
    },
    {
      "description": "Payment rows must correlate with request and retry logs.",
      "fields": [
        "payments.request_id",
        "logs.request_id"
      ],
      "must_preserve": true,
      "name": "request_correlation",
      "type": "cross_source_identity"
    },
    {
      "description": "The two problematic amounts must remain equal.",
      "fields": [
        "payments.amount"
      ],
      "must_preserve": true,
      "name": "amount_equality",
      "type": "numeric_equality"
    },
    {
      "description": "Initial processing must precede the timeout, retry, and duplicate insert.",
      "fields": [
        "payments.created_at",
        "logs.timestamp"
      ],
      "must_preserve": true,
      "name": "timestamp_order",
      "type": "ordering"
    },
    {
      "description": "The 2.767-second gap between duplicate records is diagnostic.",
      "fields": [
        "payments.created_at"
      ],
      "must_preserve": true,
      "name": "duplicate_interval",
      "type": "temporal_interval"
    },
    {
      "description": "Both duplicate rows and surrounding rows must remain present.",
      "fields": [
        "payments.payment_id"
      ],
      "must_preserve": true,
      "name": "payment_row_count",
      "type": "row_cardinality"
    },
    {
      "description": "Literal identity values are unnecessary for this diagnosis.",
      "fields": [
        "customers.name",
        "customers.ssn",
        "customers.email",
        "customers.customer_id"
      ],
      "must_preserve": false,
      "name": "literal_customer_identity",
      "type": "string_format"
    },
    {
      "description": "The literal account identifier is unnecessary for this diagnosis.",
      "fields": [
        "accounts.account_id"
      ],
      "must_preserve": false,
      "name": "literal_account_identity",
      "type": "string_format"
    }
  ],
  "difficulty": "easy",
  "expected_evidence": [
    {
      "description": "Two successful payments share customer, account, request, and amount.",
      "references": [
        "payments.customer_id",
        "payments.account_id",
        "payments.request_id",
        "payments.amount",
        "payments.status"
      ]
    },
    {
      "description": "The second payment follows the first by 2.767 seconds.",
      "references": [
        "payments.created_at"
      ]
    },
    {
      "description": "Logs show a timeout-triggered retry and no idempotency check on either insert.",
      "references": [
        "logs.request_id",
        "logs.timestamp",
        "logs.idempotency_check"
      ]
    }
  ],
  "ground_truth_root_cause": "A client retried after an upstream timeout, and the payment worker processed the same request twice because it did not enforce an idempotency check.",
